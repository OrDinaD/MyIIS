  "validation": {
    "fio": {
      "required": true,
      "regex": "^[a-zA-Zа-яА-ЯЁёЎўІі.'\\- ]+$",
      "normalization": "trim, collapse spaces, capitalize first character and characters after start/space/dot, then split into lastName/firstName/middleName"
    },
    "email": {
      "required": true,
      "format": "email",
      "blockedSuffix": "@tut.by (case-sensitive in frontend code)"
    },
    "phone": {
      "required": "category-dependent",
      "rule": "Must not consist only of spaces; no numeric format validation in the ordinary phone field."
    },
    "department": {
      "required": "category-dependent",
      "source": "searchDepartments"
    },
    "roomBuilding": {
      "required": "category-dependent",
      "source": "searchAuditories",
      "formatUsedByUI": "<room>-<building>"
    },
    "computerName": {
      "required": "category-dependent",
      "rule": "Must not consist only of spaces."
    },
    "printerName": {
      "required": "category-dependent",
      "rule": "Must not consist only of spaces."
    },
    "inventoryNumber": {
      "required": "category-dependent",
      "regex": "^[а-яА-ЯёЁ0-9]+$"
    },
    "group": {
      "required": "category-dependent",
      "regex": "^((\\d{6})|(\\dA\\d{4}))$"
    },
    "description": {
      "required": "category-dependent",
      "trimmed": true
    },
    "subcategory": {
      "requiredWhen": "bugReportSubcategoriesDto.length > 1"
    },
    "attachments": {
      "totalMaxBytes": 52428800,
      "nonEmpty": true,
      "filenameCannotContain": "..",
      "extensionRequired": true,
      "prohibitedExtensions": [
        ".ade",
        ".adp",
        ".apk",
        ".appx",
        ".appxbundle",
        ".bat",
        ".cab",
        ".chm",
        ".cmd",
        ".com",
        ".cpl",
        ".dll",
