            "mimeType": "text/html",
            "text": "<html>\n\n<head>\n    <title>Вход на сайт | СЭО</title>\n    <meta name=\"viewport\" content=\"width=device-width, user-scalable=no\" />\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.3.0/css/all.min.css\" />\n    <link href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@300;500&display=swap\" rel=\"stylesheet\">\n    <meta name=\"keywords\" content=\"lms, сэо, lms бгуир, вход, лмс, lms bsuir, сэо бгуир, бгуир,  дистанционка, до, сдо, до бгуир, црдо\">\n    <meta name=\"description\" content=\"Вход в систему СЭО.\">\n    <meta name=\"google-site-verification\" content=\"Os-IvCE01tqe0r3eLuOPO-mKG6JJ8uovJYwy71LMcf4\" />\n    <meta name=\"yandex-verification\" content=\"34f943fb07d72fe3\" />\n\n    <style>\n\n        ::-webkit-scrollbar {\n            width: 3px;\n        }\n\n        ::-webkit-scrollbar-track {\n            background-color:  #EAEBEE;\n            border-radius: 5px;\n        }\n\n        ::-webkit-scrollbar-thumb {\n            background-color: #324F73;\n            border-radius: 5px;\n        }\n\n        body {\n            background: #EAEBEE;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            box-sizing: border-box;\n            margin: 0;\n            font-family: 'Roboto', sans-serif;\n            font-weight: 300;\n            min-height: 100vh;\n\n        }\n\n        p {\n            margin: 0;\n        }\n\n        form {\n            box-sizing: border-box;\n        }\n\n        a {\n            color: #324F73;\n            cursor: pointer;\n            font-weight: 500;\n            text-decoration: none;\n        }\n\n        footer {\n            position: absolute;\n            bottom: 0;\n            display: flex;\n            justify-content: center;\n            width: 100%;\n            padding-bottom: 5px;\n\n        }\n\n        h3{\n            margin: 0;\n        }\n\n        details {\n            font-size: 1.05em;\n            margin-bottom: 7px;\n            transition: height 0.3s ease-in-out;\n        }\n\n        details>summary::before {\n            content: \"\";\n            background: url(\"../pix/chevron-right-solid.svg\");\n            background-size: contain;\n            width: 0.4em;\n            height: 0.6em;\n            display: inline-block;\n            margin-right: 5px;\n        }\n\n        details[open] summary::before {\n            transform: rotate(90deg);\n        }\n\n        details>summary {\n            list-style: none;\n            -webkit-appearance: none;\n        }\n\n        /* основные элементы  */\n\n        .login-container {\n            width: 1000px;\n            height: auto;\n            min-height: 455px;\n            background-color: white;\n            display: grid;\n            grid-template-columns: 40% 60%;\n            margin: 3vh 0;\n        }\n\n        .image-container {\n            display: flex;\n            flex-direction: column;\n            gap: 5px;\n            align-items: center;\n            justify-content: center;\n            border-right: 2px solid #EAEBEE;\n        }\n\n        .form-container {\n            padding: 3vh 5vh;\n        }\n\n        .vertical-line {\n            background-color: #EAEBEE;\n            height: 60vh;\n            width: 1px;\n        }\n\n        /* работа с изображением */\n\n        .form-image {\n            width: 380px;\n        }\n\n        .logo-image {\n            width: 300px;\n            height: 50px;\n\n        }\n\n        .form-title {\n            color: #324F73;\n            font-size: 1.3em;\n            font-weight: 500;\n            margin-bottom: 10px;\n        }\n\n        /* работа с формой */\n\n        .input-form {\n            height: 100%;\n            width: 100%;\n            border-color: transparent;\n            padding: 0;\n        }\n\n        .input-container {\n            position: relative;\n            box-sizing: border-box;\n            height: 38px;\n            width: 100%;\n            overflow: hidden;\n            border-radius: 10px;\n            border: solid 1px #EAEBEE;\n            margin-bottom: 13px;\n        }\n\n        .input-icon {\n            position: absolute;\n            top: 50%;\n            left: 11px;\n            transform: translateY(-50%);\n            color: white;\n        }\n\n        input:autofill{\n\t\t\tfont-family: \"Roboto\";\n\t\t\tfont-size: 1.1em; \n            border-radius: 10px;\n\t\t\t-webkit-box-shadow: 0 0 0 1000px white inset;\n            border: solid 2px #EAEBEE;\n\t\t}\n\n\t\tinput:autofill:focus{\n\t\t\tborder: solid 2px #EAEBEE;\n\t\t}\n\n        input:focus {\n            outline: none;\n        }\n\n        .input-container input[type=\"text\"],\n        input[type=\"password\"] {\n            padding-left: 15px;\n            font-size: 1.1em;\n            font-family: \"Roboto\", sans-serif;\n            font-weight: 300;\n        }\n\n        .icon-container {\n            background-color: #EAEBEE;\n            width: 40px;\n            height: 100%;\n            position: absolute;\n            right: 0;\n            top: 0;\n        }\n\n        .button-submit {\n            background-color: #324F73;\n            color: white;\n            height: 38px;\n            width: 40%;\n            font-size: 1.2em;\n            border-color: transparent;\n            font-family: 'Roboto', sans-serif;\n            font-weight: 300;\n            border-radius: 10px;\n            cursor: pointer;\n        }\n\n        .logo-mini-image {\n            width: 100px;\n            display: none;\n            margin: 0 auto 15px;\n        }\n\n        .help-text {\n            background-color: #EAEBEE;\n            border-radius: 10px;\n            padding: 5px 13px;\n            font-size: 0.9em;\n            margin-top: 8px;\n            box-sizing: border-box;\n        }\n\n        .help-text>p {\n            margin: 6px 0;\n        }\n\n        .icon {\n            position: absolute;\n            top: 50%;\n            right: 80px;\n            transform: translateY(-50%);\n            cursor: pointer;\n        }\n\n        .icon i {\n            font-size: 1em;\n            color: #324F73;\n            background: white;\n        }\n\n        #error-container{\n            height: 30px;\n            background-color: #f4cec5;\n            border-radius: 10px;\n            margin-bottom: 10px;\n            display: none;\n            padding-left: 15px;\n            font-size: 0.9em;\n        }        \n\n        .select-language {\n            background: transparent;\n            font-family: \"Roboto\", sans-serif;\n            border: none;\n        }\n\n        .cookie-button {\n            border-radius: 10px;\n            background: #dcdcdc;\n            border: none;\n            height: 30px;\n        }\n\n        /* работа с модальным окном */\n\n        .hystmodal {\n            display: none;\n            justify-content: center;\n            align-items: center;\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            background-color: rgba(0, 0, 0, 0.5);\n            z-index: 1000;\n        }\n\n        .hystmodal__wrap {\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            background-color: #fff;\n            padding: 20px;\n            border-radius: 5px;\n            width: 40%;\n            height: auto;\n            overflow-y: auto;\n        }\n\n        .hystmodal__window {\n            font-family: \"Roboto\";      \n            font-size: 1em;  \n            display: block;\n           \n        }\n\n        .hystmodal__close {\n            border: none;\n            background: none;\n            cursor: pointer;\n        }\n\n        .modal-header{\n            display: flex;\n            justify-content: space-between;\n            align-items: baseline;\n        }\n\n        .modal-button-container{\n            display: flex;\n            justify-content: right;\n        }\n\n        #modal-button{\n            background-color: #324F73;\n            color: white;\n            height: 30px;\n            width: 20%;\n            border-color: transparent;\n            font-family: 'Roboto', sans-serif;\n            font-weight: 300;\n            border-radius: 10px;\n            cursor: pointer;\n        }\n\n        .modal-icon:hover{\n            color: red;\n        }\n\n        .cookie-text{\n            margin: 5px 0;\n        }\n\n\n        /* медиа-запросы */\n        @media all and (orientation: landscape) and (max-width: 1200px) and (min-width: 600px){\n            .login-container{\n                width: 90vw;\n                min-height: 200px;\n                grid-template-columns: repeat(1, 1fr);\n                height: fit-content;\n            }\n           \n            main{\n                height: fit-content;\n            }\n\n            .image-container {\n                display: none;\n            }\n\n            .form-container{\n                height: fit-content;\n            }\n\n            .logo-mini-image {\n                display: block;\n            }\n\n            body{\n                align-items: unset;\n                height: auto;\n            }\n\n            .form-title {\n                font-size: 1.2em;\n            }\n\n            .hystmodal__wrap {\n                max-height: 90vh;\n                width: 80%;\n            }\n\n            .hystmodal__window {\n                font-size: 0.9em;  \n            }\n        }\n    \n        @media (max-height: 400px) {\n            footer {\n                position: unset;\n            }\n\n            body {\n                height: 102vh;\n                flex-direction: column;\n                justify-content: space-between;\n                align-items: center;\n            }\n\n            .hystmodal__wrap {\n                width: 80%;\n                max-height: 80vh;  \n            }\n\n            .hystmodal__window {\n                font-size: 0.8em;  \n            }\n        }\n\n          @media all and (orientation: portrait) and (max-width: 1200px) and (min-width: 600px) {\n            .image-container {\n                display: none;\n            }\n            body{\n                align-items: unset;\n                height: auto;\n            }\n\n            .input-container {\n                height: 35px;\n                margin-bottom: 15px;\n            }\n\n            .login-container {\n                grid-template-columns: repeat(1, 1fr);\n                width: 80vw;\n            }\n\n            .input-container input[type=\"text\"],\n            input[type=\"password\"] {\n                padding-left: 8px;\n                font-size: 1.2em;\n            }\n\n            details {\n                font-size: 1em;\n            }\n\n            .button-submit {\n                font-size: 1.2em;\n                width: 100%;\n                height: 35px;\n            }\n\n            .help-text {\n                font-size: 0.9em;\n        \n            }\n\n            .logo-mini-image {\n                display: block;\n            }\n\n            .form-container{\n                height: fit-content;\n            }\n\n            .form-title {\n                font-size: 1.2em;\n            }\n            \n            footer {\n                position: unset;\n            }\n\n            body {\n                flex-direction: column;\n                justify-content: space-between;\n                align-items: center;\n            } \n\n            .hystmodal__wrap {\n                width: 80%;\n                max-height: 80vh; \n            }\n\n            .hystmodal__window {\n                font-size: 0.9em;  \n            }\n        }\n\n        @media (max-width: 600px) and (min-width: 350px) {\n            .image-container {\n                display: none;\n            }\n\n            .input-container {\n                height: 33px;\n                margin-bottom: 13px;\n            }\n\n            body{\n                align-items: unset;\n                height: auto;\n            }\n\n            .login-container {\n                grid-template-columns: repeat(1, 1fr);\n                width: 90vw;\n                min-height: fit-content;\n            }\n\n            .help-text {\n                font-size: 0.9em;\n            }\n\n            footer {\n                position: unset;\n            }\n\n            body {\n                flex-direction: column;\n                justify-content: space-between;\n                align-items: center;\n            } \n\n            .input-container input[type=\"text\"],\n            input[type=\"password\"] {\n                padding-left: 8px;\n                font-size: 1em;\n\n            }\n\n            .button-submit {\n                font-size: 1em;\n                width: 100%;\n                height: 33px;\n\n            }\n\n            details {\n                font-size: 0.9em;\n            }\n\n            .logo-mini-image {\n                display: block;\n            }\n\n            .form-container{\n                height: fit-content;\n            }\n\n            .form-title {\n                font-size: 1.05em;\n                text-align: center;\n            }\n\n            .hystmodal__wrap {\n                width: 80%;\n                max-height: 80vh;\n            }\n\n            .hystmodal__window{\n                font-size: 0.9em;\n            }\n        }\n\n        @media (max-width: 350px) {\n            .login-container {\n                display: none;\n            }\n\n            .hystmodal{\n                display:none;\n            }\n\n            footer{\n                display: none;\n            }\n        }\n    </style>\n</head>\n\n<body>\n    <main>\n        <div class=\"login-container\">\n            <div class=\"image-container\">\n                <img class=\"form-image\" src=\"../pix/LMS.png\">\n            </div>\n            <div class=\"form-container\">\n                <img class=\"logo-mini-image\" src=\"../pix/bsuir.png\">\n                <h1 class=\"form-title\" id=\"form-title\">Система электронного обучения</h1>\n                <div id=\"error-container\"><p id=\"error-message\"></p></div>\n                <FORM action=\"https://lms.bsuir.by/login/index.php\" method=\"POST\">\n\n                    <div class=\"input-container\">\n                        <input class=\"input-form\" id=\"input-login\" type=text name=\"username\" placeholder=\"Логин\" maxlength=\"60\">\n                        <div class=\"icon-container\">\n                            <i class=\"input-icon fa-solid fa-lg fa-user\"></i>\n                        </div>\n\n                        <br>\n                    </div>\n                    <div class=\"input-container\">\n                        <input class=\"input-form\" id=\"input-password\" type=password name=\"password\" placeholder=\"Пароль\" maxlength=\"60\">\n                        \n                        <span class=\"icon\" id=\"togglePassword\">\n                            <i class=\"input-icon fa-regular fa-eye-slash\"></i>\n                        </span>\n                        <div class=\"icon-container\">\n                            <i class=\"input-icon fa-solid fa-lg fa-lock\"></i>\n                        </div>\n                    </div>\n                    <INPUT class=\"button-submit\" id=\"button-submit\" type=\"SUBMIT\" value=\"Вход\">\n                </FORM>\n                <details id=\"details1\">\n                    <summary class=\"sum\" id='summary1'>Вы в первый раз на нашем сайте?</summary>\n                    <div class=\"help-text\">\n                        <p id=\"details1-text1\">Учетные данные для авторизации аналогичны тем, которые используются для доступа к\n                            <a href=\"https://iis.bsuir.by/\" target=\"_blank\">ИИС «БГУИР: Университет»</a>.\n                        </p>\n                        <p id=\"details1-text2\">\n                        Логин для студентов – номер студенческого билета, для преподавателей — имя почтового ящика БГУИР без @bsuir.by.\n                        </p>\n                    </div>\n                </details>\n                <details id=\"details2\">\n                    <summary id='summary2' >Что делать, если логин/пароль не работают? </summary>\n                    <div class=\"help-text\">\n                        <p id=\"details2-text1\">В случае возникновения проблем со входом необходимо \n                            <a href=\"https://iis.bsuir.by/password-recovery\" target=\"_blank\">восстановить пароль</a> в ИИС «БГУИР: Университет».\n                        </p>\n                        <p id=\"details2-text2\">\n                            Если самостоятельно сбросить пароль не удалось, воспользуйтесь пунктом &laquoВосстановление\n                            пароля&raquo в\n                            <a href=\"https://courses.bsuir.by/support.html\" target=\"_blank\">форме связи с техподдержкой</a>.\n                        </p>\n                    </div>\n                </details>\n            </div>\n        </div>\n    </main>\n    <footer>\n        <select class=\"select-language\" id=\"select-language\">\n            <option value=\"ru\" selected>Русский (ru)</option>\n            <option value=\"en\">English (en)</option>\n            <option value=\"blr\">Беларуская (be)</option>\n        </select>\n        <button class=\"cookie-button\" id=\"cookie-button\">Уведомление о файлах cookies</button>\n    </footer>\n\n    <div class=\"hystmodal\" id=\"myModal\" >\n        <div class=\"hystmodal__wrap\">\n            <div class=\"hystmodal__window\" role=\"dialog\" >\n                <div class=\"modal-header\">\n                    <h3 id=\"modal-header\">В Вашем браузере должен быть разрешен прием cookies</h1>\n                    <!-- <button class=\"hystmodal__close\" > -->\n                        <i class=\"hystmodal__close modal-icon fa-solid fa-xmark\"></i>\n                    <!-- </button> -->\n                </div>\n                <p class=\"cookie-text\" id=\"modal-text1\">На этом сайте используется два файла cookie:</p>\n                <p class=\"cookie-text\" id=\"modal-text2\">Строго необходимым является файл cookie для сеансов, обычно называемый MoodleSession. Вы должны разрешить использование этого файла cookie в своем браузере, чтобы обеспечить непрерывность при переходах и оставаться в системе при просмотре сайта. Когда вы выходите из системы или закрываете браузер, этот файл cookie уничтожается (в вашем браузере и на сервере).\n                </p>\n                <p class=\"cookie-text\" id=\"modal-text3\">\n                    Другой файл cookie предназначен исключительно для удобства и обычно называется MOODLEID или аналогично. Он используется для сохранения вашего логина в браузере. Это означает, что когда вы вернетесь на этот сайт, поле логин на странице входа уже будет заполнено. Можно отказаться от использования этого файла cookie, но тогда вам придется каждый раз при открытии сайта вводить свой логин заново.\n                </p>\n                <div class=\"modal-button-container\">\n                    <button class=\"hystmodal__close\" id=\"modal-button\">Ok</button>\n                </div>  \n                \n            </div>\n        </div>\n    </div>\n\n\n    <script>\n        const details1 = document.getElementById('details1');\n        const details2 = document.getElementById('details2');\n\n        const passwordInput = document.getElementById(\"input-password\");\n        const togglePasswordIcon = document.getElementById(\"togglePassword\");\n        const eyeIcon = togglePasswordIcon.querySelector('i'); \n\n        const savedLang = localStorage.getItem('selectedLang');\n        const selectLanguage = document.getElementById('select-language');\n\n        const elementsToTranslate = document.querySelectorAll(\n            '.sum, p, input, h1, h3, .help-text, a, summary, button'\n        )\n        const detailsElements = document.querySelectorAll('details');\n\n        const modal = document.getElementById('myModal');\n        const openModalButton = document.getElementById('cookie-button'); \n\n        const translations = {\n            \"ru\": {\n                \"form-title\": \"Система электронного обучения\",\n                \"input-login\": \"Логин\",\n                \"input-password\": \"Пароль\",\n                \"button-submit\": \"Вход\",\n                \"summary1\": \"Вы в первый раз на нашем сайте?\",\n                \"details1-text1\": \"Учетные данные для авторизации аналогичны тем, которые используются для доступа к <a href=\\\"https://iis.bsuir.by/\\\" target=\\\"_blank\\\">ИИС «БГУИР: Университет»</a>.\",               \n                 \"details1-text2\": \"Логин для студентов – номер студенческого билета, для преподавателей — имя почтового ящика БГУИР без @bsuir.by.\",\n                \"summary2\": \"Что делать, если логин/пароль не работают?\",\n                \"details2-text1\": \"В случае возникновения проблем со входом необходимо <a href=\\\"https://iis.bsuir.by/password-recovery\\\" target=\\\"_blank\\\">восстановить пароль</a> в ИИС «БГУИР: Университет».\",\n                \"details2-text2\": \"Если самостоятельно сбросить пароль не удалось, воспользуйтесь пунктом &laquoВосстановление пароля&raquo в <a href=\\\"https://courses.bsuir.by/support.html\\\" target=\\\"_blank\\\">форме связи с техподдержкой</a>.\",\n                \"cookie-button\": \"Уведомление о файлах cookies\",\n                \"modal-header\":\"В Вашем браузере должен быть разрешен прием cookies\",\n                \"modal-text1\":\"На этом сайте используется два файла cookie:\",\n                \"modal-text2\":\"Строго необходимым является файл cookie для сеансов, обычно называемый MoodleSession. Вы должны разрешить использование этого файла cookie в своем браузере, чтобы обеспечить непрерывность при переходах и оставаться в системе при просмотре сайта. Когда вы выходите из системы или закрываете браузер, этот файл cookie уничтожается (в вашем браузере и на сервере).\",\n                \"modal-text3\":\"Другой файл cookie предназначен исключительно для удобства и обычно называется MOODLEID или аналогично. Он используется для сохранения вашего логина в браузере. Это означает, что когда вы вернетесь на этот сайт, поле логин на странице входа уже будет заполнено. Можно отказаться от использования этого файла cookie, но тогда вам придется каждый раз при открытии сайта вводить свой логин заново.\",\n                \"modal-button\": \"Ок\"\n            },\n            \"en\": {\n                \"form-title\": \"E-Learning System\",\n                \"input-login\": \"Login\",\n                \"input-password\": \"Password\",\n                \"button-submit\": \"Login\",\n                \"summary1\": \"Are you new to our website?\",\n                \"details1-text1\": \"The authorization credentials are the same as those used to access the  <a href=\\\"https://iis.bsuir.by/\\\" target=\\\"_blank\\\">IIS «BSUIR: University»</a>.\",\n                \"details1-text2\": \"Login for students - student ID number, for teachers - the name of the BSUIR mailbox without @bsuir.by.\",\n                \"summary2\": \"What to do if login/password does not work?\",\n                \"details2-text1\": \"If you have problems logging in, you need to <a href=\\\"https://iis.bsuir.by/password-recovery\\\" target=\\\"_blank\\\">restore your password</a> in the IIS «BSUIR: University».\",\n                \"details2-text2\": \"If you are unable to reset your password yourself, use the \\\"Password Recovery\\\" item in the contact form with <a href=\\\"https://courses.bsuir.by/support.html\\\" target=\\\"_blank\\\">technical support</a>.\",\n                \"cookie-button\": \"Cookies notification\", \n                \"modal-header\":\"Cookies must be enabled in your browser\",\n                \"modal-text1\":\"Two cookies are used on this site:\",\n                \"modal-text2\":\"The essential one is the session cookie, usually called MoodleSession. You must allow this cookie in your browser to provide continuity and to remain logged in when browsing the site. When you log out or close the browser, this cookie is destroyed (in your browser and on the server).\",\n                \"modal-text3\":\"The other cookie is purely for convenience, usually called MOODLEID or similar. It just remembers your username in the browser. This means that when you return to this site, the username field on the login page is already filled in for you. It is safe to refuse this cookie - you will just have to retype your username each time you log in.\",\n                 \"modal-button\": \"Ok\"\n            },\n            \"blr\": {\n                \"form-title\": \"Сістэма электроннага навучання\",\n                \"input-login\": \"Увайсці\",\n                \"input-password\": \"Пароль\",\n                \"button-submit\": \"Увайсці\",\n                \"summary1\": \"Вы ўпершыню на нашым сайце?\",\n                \"details1-text1\": \"Дадзеныя для аўтарызацыі аналагічныя тым, якія выкарыстоўваюцца для доступу да <a href=\\\"https://iis.bsuir.by/\\\" target=\\\"_blank\\\">ІІС «БДУІР: Універсітэт»</a>.\",\n                \"details1-text2\": \"Уваход для студэнтаў - нумар студэнцкага білета, для выкладчыкаў - імя паштовай скрыні БДУІР без @bsuir.by.\",\n                \"summary2\": \"Што рабіць, калі лагін/пароль не працуюць?\",\n                \"details2-text1\": \"У выпадку ўзнікнення праблем з уваходам неабходна <a href=\\\"https://iis.bsuir.by/password-recovery\\\" target=\\\"_blank\\\">аднавіць пароль</a> у ІІС «БДУІР: Універсітэт».\",\n                \"details2-text2\": \"Калі самастойна скінуць пароль не атрымалася, скарыстайцеся пунктам &laquoАднаўленне пароля&raquo  у <a href=\\\"https://courses.bsuir.by/customforms/support.html\\\" target=\\\"_blank\\\">форме сувязі з тэхпадтрымкай</a>.\",\n                \"cookie-button\": \"Апавяшчэнне аб файлах cookies\",\n                \"modal-header\":\"У вашым браўзэры павінен быць дазволены прыём cookies\",\n                \"modal-text1\":\"На гэтым сайце выкарыстоўваецца два файлы cookie:\",\n                \"modal-text2\":\"Строга неабходным з'яўляецца файл cookie для сеансаў, звычайна званы MoodleSession. Вы павінны дазволіць выкарыстанне гэтага cookie ў вашым браўзэры, каб забяспечыць бесперапыннасць пры пераходах і заставацца ў сістэме пры праглядзе сайта. Калі вы выходзіце з сістэмы або зачыняеце браўзэр, гэты файл cookie знішчаецца (у вашым браўзэры і на серверы).\",\n                \"modal-text3\":\"Іншы файл cookie прызначаны выключна для зручнасці і звычайна называецца MOODLEID або аналагічна. Ён выкарыстоўваецца для захавання вашага лагіна ў браўзэры. Гэта азначае, што калі вы вернецеся на гэты сайт, поле лагін на старонцы ўваходу ўжо будзе запоўнена. Можна адмовіцца ад выкарыстання гэтага файла cookie, але тады вам прыйдзецца кожны раз пры адкрыцці сайта ўводзіць свой лагін нанова.\",\n                 \"modal-button\": \"Ок\"\n        \n            }\n        };\n\n        \n\n        details1.addEventListener('click', function () {\n            details2.open = false;\n        });\n\n        details2.addEventListener('click', function () {\n            details1.open = false;\n        });\n\n        togglePasswordIcon.addEventListener(\"click\", () => {\n    \n        if (passwordInput.type === \"password\") {\n            passwordInput.type = \"text\";\n            eyeIcon.classList.remove(\"fa-eye-slash\");\n            eyeIcon.classList.add(\"fa-eye\"); \n        } else {\n            passwordInput.type = \"password\";\n            eyeIcon.classList.remove(\"fa-eye\");\n            eyeIcon.classList.add(\"fa-eye-slash\");\n        }\n        });\n        \n        if (savedLang) {\n            selectLanguage.value = savedLang;\n            translatePage(savedLang);\n        }\n        function translatePage(lang) {\n            console.log(elementsToTranslate)\n            elementsToTranslate.forEach(element => {\n                if (element.tagName === 'SUMMARY' ) {\n                    element.textContent = translations[lang][element.id];\n                } else if (element.tagName === 'P' || element.tagName === 'H1' || element.tagName === 'H3') {\n                    element.innerHTML = translations[lang][element.id];\n                } else if (element.tagName === 'INPUT' && element.type === 'text' || element.type === 'password') {\n                    element.placeholder = translations[lang][element.id];\n                } else if (element.tagName === 'INPUT' && element.type === 'submit' ) {\n                    element.value = translations[lang][element.id];\n                }\n                else if(element.tagName === 'BUTTON'){\n                    element.textContent = translations[lang][element.id];\n\n                }\n            });\n        }\n\n        selectLanguage.addEventListener('change', () => {\n            const selectedLang = selectLanguage.value;\n            localStorage.setItem('selectedLang', selectedLang);\n            translatePage(selectedLang);\n        });\n\n\n        detailsElements.forEach(details => {\n            const summary = details.querySelector('summary');\n            summary.style.listStyle = 'none'; \n        });\n\n       \n        openModalButton.addEventListener('click', () => {\n            modal.style.display = 'flex';\n        });\n\n        const closeButtons = document.querySelectorAll('.hystmodal__close');\n\n        closeButtons.forEach(button => {\n            button.addEventListener('click', () => {\n                modal.style.display = 'none';\n            });\n        });\n\n        modal.addEventListener('click', (event) => {\n            if (event.target === modal) {\n                modal.style.display = 'none';\n            }\n        });\n    </script>\n            \n            \n</body>\n<!-- Yandex.Metrika counter -->\n<script type=\"text/javascript\" >\n                (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};\n                m[i].l=1*new Date();\n                for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}\n                k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})\n                (window, document, \"script\", \"https://mc.yandex.ru/metrika/tag.js\", \"ym\");\n\n                ym(51942134, \"init\", {\n                        clickmap:true,\n                        trackLinks:true,\n                        accurateTrackBounce:true\n                });\n            </script>\n            <noscript><div><img src=\"https://mc.yandex.ru/watch/51942134\" style=\"position:absolute; left:-9999px;\" alt=\"\" /></div></noscript>\n<!-- /Yandex.Metrika counter -->\n</html>\n\n\n\n"
          },
