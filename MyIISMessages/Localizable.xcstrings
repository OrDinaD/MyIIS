    "Откройте зачетку в MyIIS один раз. После этого здесь появятся карточки для iMessage.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адкрыйце залікоўку ў MyIIS адзін раз. Пасля гэтага тут з’явяцца карткі для iMessage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the gradebook in MyIIS once. Cards for iMessage will then appear here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте зачётку в MyIIS один раз. После этого здесь появятся карточки для iMessage."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте заліковку в MyIIS один раз. Після цього тут з’являться картки для iMessage."
          }
        }
      }
